ailytrib.com/2026/09/25/transmission-line-decision-delayed/<br>counties: TX: Bell, TX: Burnet, TX: Concho, TX: Coryell, TX: Lampasas, TX: Llano, TX: Mason, TX: McCulloch, TX: Menard, TX: Milam, TX: Mills, TX: San Saba, TX: Schleicher, TX: Tom Green, TX: Williamson<br>counties_basis: study area per CCN application (Docket 59475 case style); the notice says route links are only in Bell, Burnet, Concho, Lampasas, Mason, McCulloch, Menard, San Saba, Schleicher, Tom Green and Williamson]]></description><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>-97.07,30.986 -97.259,30.89 -97.316,30.752 -97.625,30.87 -97.829,30.906 -97.912,31.035 -97.914,31.066 -97.419,31.32 -97.343,31.244 -97.278,31.28 -97.07,30.986</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-97.912,31.035 -97.829,30.906 -97.963,30.786 -98.123,30.485 -98.126,30.426 -98.351,30.486 -98.439,30.673 -98.372,30.74 -98.432,30.786 -98.377,30.835 -98.446,30.921 -98.44,31.03 -97.912,31.035</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-100.111,31.58 -99.722,31.577 -99.602,31.492 -99.603,31.087 -100.115,31.088 -100.111,31.58</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-97.766,31.672 -97.69,31.711 -97.419,31.32 -97.907,31.069 -98.18,31.464 -97.766,31.672</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-98.563,31.231 -98.18,31.464 -97.907,31.069 -97.912,31.035 -98.44,31.03 -98.523,31.089 -98.51,31.156 -98.563,31.231</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-98.964,30.498 -98.965,30.921 -98.446,30.921 -98.377,30.835 -98.432,30.786 -98.372,30.74 -98.439,30.673 -98.351,30.486 -98.411,30.502 -98.964,30.498</coordinates></LinearRing></outerBoundaryIs></Polygon><Polygon><outerBoundaryIs><LinearRing><coordinates>-98.965