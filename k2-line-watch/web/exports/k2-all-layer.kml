><Data name="stage"><value>approved</value></Data><Data name="stage_detail"><value>PUCT Docket 59430 filed 3/4/2026 for a new 4.81-6.95 mile single-circuit 230 kV line from Jacinto to a planned Lone Star substation interconnecting the 453 MW Lone Star Power Station (plant expected mid-2028); PUCT Notice of Approval issued 6/16/2026. miles_new is the upper end of the filed range; final route length not checked.</value></Data><Data name="builder"><value>Entergy Texas</value></Data><Data name="from_status"><value>existing, expanding</value></Data><Data name="from_there_now"><value>yes</value></Data><Data name="from_work"><value>adding to it (new line, transformer or expansion)</value></Data><Data name="from_work_stage"><value>approved</value></Data><Data name="to_status"><value>unconfirmed</value></Data><Data name="to_there_now"><value>unknown</value></Data><Data name="to_work"><value>new line or substation work planned</value></Data><Data name="to_work_stage"><value>approved</value></Data><Data name="location_quality"><value>county</value></Data><Data name="queue_projects"><value>0</value></Data><Data name="queue_mw"><value>0</value></Data><Data name="geometry_note"><value>Straight line between the end substations, not the route</value></Data></ExtendedData><LineString><tessellate>1</tessellate><coordinates>-95.06387,30.37043,0 -95.1686,30.5823,0</coordinates></LineString></Placemark><Placemark><name>Oak Run Solar 230 kV gen-ties (2 lines)</name><styleUrl>#approved</styleUrl><ExtendedData><Data name="feature_type"><value>line</value></Data><Data name="id"><value>pjmr-oh-oak-run-230-gentie</value></Data><Data name="name"><value>Oak Run Solar 230 kV gen-ties (2 lines)</value></Data><Data name="kv"><value>230</value></Data><Data name="project_type"><value>new line</value></Data><Data name="miles_new"><value>6.9</value></Data><Data name="miles_upgraded"><value>0</value></Data><Data name="purpose"><value>shared grid</value></Data><Data name="tappable"><value>yes</value></D