?docid=582011</value></Data><Data name="stage"><value>approved</value></Data><Data name="stage_detail"><value>PSCW final decision Jan 9, 2026 (9829-CE-100) for a 163.8 MW solar facility with a 2.5-mile 138 kV gen-tie in the Towns of Buena Vista and Pine Grove (cited in the 9830-CE-100 decision; scope from the Sept 2025 WEPA report). In-service date not found.</value></Data><Data name="builder"><value>Porchlight Solar</value></Data><Data name="from_status"><value>unconfirmed</value></Data><Data name="from_there_now"><value>unknown</value></Data><Data name="from_work"><value>new line or substation work planned</value></Data><Data name="from_work_stage"><value>approved</value></Data><Data name="to_status"><value>unconfirmed</value></Data><Data name="to_there_now"><value>unknown</value></Data><Data name="to_work"><value>new line or substation work planned</value></Data><Data name="to_work_stage"><value>approved</value></Data><Data name="location_quality"><value>county</value></Data><Data name="queue_projects"><value>0</value></Data><Data name="queue_mw"><value>0</value></Data><Data name="geometry_note"><value>Straight line between the end substations, not the route</value></Data></ExtendedData><LineString><tessellate>1</tessellate><coordinates>-89.5018,44.4757,0 -89.5018,44.4757,0</coordinates></LineString></Placemark><Placemark><name>Akron Solar 138 kV generator tie (~1.8 mi)</name><styleUrl>#approved</styleUrl><ExtendedData><Data name="feature_type"><value>line</value></Data><Data name="id"><value>misor-wi-akron-solar-138-gentie</value></Data><Data name="name"><value>Akron Solar 138 kV generator tie (~1.8 mi)</value></Data><Data name="kv"><value>138</value></Data><Data name="project_type"><value>new line</value></Data><Data name="miles_new"><value>1.8</value></Data><Data name="miles_upgraded"><value>0</value></Data><Data name="purpose"><value>shared grid</value></Data><Data name="tappable"><value>yes</value></Data><Data name="tap_note"><value>The line itself can be ta